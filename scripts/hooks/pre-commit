#!/bin/sh
#
# git pre-commit hook — กันไม่ให้ commit ทั้งที่ชุดตรวจยังไม่ผ่าน
#
# เปิดใช้ครั้งเดียวต่อเครื่อง (setup.php ทำให้แล้ว):
#     git config core.hooksPath scripts/hooks
#
# ‼️ ต้องตั้งเอง เพราะ .git/hooks/ ไม่ติดมากับการ clone
#    คนที่ไม่ได้ตั้งจะไม่มีอะไรตรวจให้โดยไม่รู้ตัว
#
# ตัวนี้กันคนในทีมที่ commit เอง ส่วน .claude/settings.json กันตอน AI สั่ง commit
# ต้องมีทั้งคู่ถึงจะกันได้ครบทุกทาง
#
# ==============================================================================
# ‼️‼️ โครงสร้างของไฟล์นี้ถูกออกแบบมาเพื่อกัน SIGPIPE โดยเฉพาะ — ห้ามจัดระเบียบใหม่
#
# อาการเดิม: `git commit -m x | head -20` ทำให้ commit ที่ fail หลุดเข้าไปได้จริง
#            (ทดลองแล้ว: check.php รายงาน 21 ข้อ แต่ commit ถูกสร้าง git คืน 141)
#
# กลไก: head ปิดท่ออ่านหลังครบจำนวนบรรทัด → คำสั่งที่เขียนบรรทัดถัดไปโดน EPIPE
#        → shell ตายด้วย SIGPIPE **ก่อนถึงบรรทัด exit 1** → git ไม่ได้รับสัญญาณให้หยุด
#
# อันตรายที่สุดในบรรดากำแพงทั้งหมด เพราะ `| head` คือสิ่งที่ AI พิมพ์เป็นนิสัยเพื่อประหยัด
# context และเมื่อหลุด มันหลุด **เงียบสนิท** ไม่มีใครรู้ว่ากำแพงไม่ทำงาน
#
# กฎ 4 ข้อที่ทำให้ไฟล์นี้ข้ามไม่ได้
#   1. output ทั้งหมดไป stderr           — ท่อที่คนมักต่อคือ stdout
#   2. ตัดสินผลก่อนพิมพ์อะไรทั้งสิ้น      — exit code ต้องไม่ขึ้นกับว่าเขียนสำเร็จไหม
#   3. พิมพ์ในซับเชลล์เสมอ               — ซับเชลล์ตายไม่ลากตัวหลักตายด้วย
#   4. ห้ามใช้ set -e                    — คำสั่งที่ fail ต้องไม่จบสคริปต์แทนบรรทัด exit ของเรา
# ==============================================================================

exec 1>&2
trap '' PIPE

# พิมพ์ในซับเชลล์ — ถ้าปลายทางถูกปิด ซับเชลล์ตายไปตัวเดียว สคริปต์หลักเดินต่อจนถึง exit
say() {
    ( printf '%s\n' "$*" ) 2>/dev/null
    return 0
}

if ! command -v php >/dev/null 2>&1; then
    say "ข้ามการตรวจ: ไม่พบ php ใน PATH"
    exit 0
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

if [ ! -f scripts/check.php ]; then
    exit 0
fi

# กัน .env หลุดขึ้น git — ผิดพลาดครั้งเดียวก็ต้องเปลี่ยนรหัสทั้งชุด
STAGED=$(git diff --cached --name-only 2>/dev/null)

if printf '%s\n' "$STAGED" | grep -qx '.env'; then
    say ""
    say "✗ .env ถูก stage ไว้ — ห้าม commit เด็ดขาด"
    say "  git reset HEAD .env  แล้วตรวจว่า .gitignore ครอบคลุมแล้ว"
    say ""
    exit 1
fi

say "รันชุดตรวจมาตรฐาน..."

# ‼️ เก็บผลลงตัวแปรก่อน ห้ามให้ check.php เขียนลงท่อที่อาจถูกปิด
#    ทำแบบนี้ RESULT ถูกกำหนดเสร็จตั้งแต่ก่อนมีการพิมพ์ใดๆ
#
# --changed      ตรวจไฟล์ที่เปลี่ยน + การตรวจทั้งโปรเจค · แตะของกลางแล้วยกระดับเป็นเต็มเอง
# --reuse-stamp  ถ้า hook ของ Claude Code เพิ่งตรวจงานชุดเดียวกันผ่าน ไม่ต้องรันซ้ำ
#                ตราผูกกับเนื้อไฟล์ทุกไฟล์ที่ต่างจาก HEAD — เปลี่ยนแม้ไบต์เดียวก็ตรวจใหม่
#                CI ยังตรวจเต็มทุกครั้งหลัง merge
OUTPUT=$(php scripts/check.php --changed --reuse-stamp 2>&1)
RESULT=$?

if [ "$RESULT" -ne 0 ]; then
    say "$OUTPUT"
    say ""
    say "ยังไม่ commit — แก้ที่โค้ดก่อน"
    say "ข้ามชั่วคราวได้ด้วย git commit --no-verify แต่ CI จะจับอยู่ดี ไฟล์จะไม่ถูกอัปขึ้น server"
    say ""
    exit 1
fi

say "$OUTPUT"
exit 0
