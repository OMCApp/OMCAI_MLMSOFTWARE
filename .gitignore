# Secrets (standard/rule.md: .env must never be committed)
.env

# Dependencies
vendor/
# self-hosted front-end assets (fonts) live here and must be committed — CLAUDE.md rule 2
!public/assets/vendor/

# Runtime data — keep the folders, not their contents
storage/logs/*
storage/uploads/*
storage/backups/*
# CMS uploads (public by design — project/NOTES.md Phase 3): keep the folder rules, not the files
public/uploads/*
!public/uploads/.htaccess
!public/uploads/.gitkeep
!storage/*/.gitkeep

# Local / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Agent worktrees (temporary)
.claude/worktrees/
