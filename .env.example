# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ‼️ .env ห้าม commit ขึ้น git เด็ดขาด — หลุดครั้งเดียวต้องเปลี่ยนรหัสทั้งชุด

# ---------------------------------------------------------------- แอปพลิเคชัน
APP_NAME="ชื่อระบบ"

# ‼️ production คือค่าที่ปลอดภัยโดยปริยาย — ตั้ง development เฉพาะบนเครื่องตัวเองเท่านั้น
#    ลืมเปลี่ยนกลับบน server จริง = เปิดแสดง error ให้คนนอกเห็น
APP_ENV=production

APP_URL=https://example.com
APP_HTTPS=true
APP_TIMEZONE=Asia/Bangkok

# host ของ canonical / og:url / sitemap — production เสมอ แม้รันบน staging (ว่าง = https://mlmsoftware.omc.co.th)
# CANONICAL_URL=https://mlmsoftware.omc.co.th

# ---------------------------------------------------------------- staging
# ‼️ ใช้เมื่อ APP_ENV ไม่ใช่ production — ทุกหน้าส่ง X-Robots-Tag: noindex เสมอ
#    ตั้ง STAGING_PASS แล้วทุกหน้าต้องใส่ user/pass ก่อนเข้า (ยกเว้น /_health และ /_migrate)
#    บน production ปล่อยว่างไว้
STAGING_USER=omc
STAGING_PASS=

# ---------------------------------------------------------------- ฐานข้อมูล
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---------------------------------------------------------------- ภาษา
# th และ en เป็นค่าบังคับทุกโปรเจค เพิ่มภาษาอื่นต่อท้ายได้
APP_LOCALES=th,en
APP_DEFAULT_LOCALE=th

# ‼️ โหมดเริ่มต้นและรูปแบบเมนูไม่ได้อยู่ที่นี่ — เป็นการตัดสินใจของหน้าตา ไม่ใช่ของ environment
#    อยู่ที่ project/DESIGN.md (mode.default กับ layout.nav) แล้ว design-sync.php
#    generate ลง config/design.php ให้ · เคยคัดลอกไว้ที่นี่แล้วสองที่เถียงกันได้เงียบๆ

# ---------------------------------------------------------------- session
# วินาที · 0 = ไม่หมดอายุจากการไม่ใช้งาน
SESSION_IDLE_TIMEOUT=0

# ---------------------------------------------------------------- อัปโหลด
UPLOAD_MAX_BYTES=5242880
UPLOAD_EXTENSIONS=jpg,jpeg,png,webp,pdf

# ---------------------------------------------------------------- งานเบื้องหลัง
BACKUP_KEEP_DAYS=14
LOG_MAX_BYTES=10485760
AUDIT_KEEP_MONTHS=12

# ---------------------------------------------------------------- migration
# ‼️ นี่คือกุญแจของปลายทางที่แก้โครงสร้างฐานข้อมูลได้ ซึ่งเปิดอยู่บนอินเทอร์เน็ต
#    สุ่มใหม่ทุกโปรเจค อย่าใช้ซ้ำ · สร้างด้วย: php -r "echo bin2hex(random_bytes(32));"
#    เปลี่ยนทันทีถ้ามันเคยหลุดเข้า log, commit หรือ URL ที่แชร์ออกไป
MIGRATE_TOKEN=

# ---------------------------------------------------------------- cookie อุปกรณ์
# ‼️ กุญแจ HMAC ของ cookie "เครื่องนี้เคยล็อกอินสำเร็จ" (core/DeviceCookie.php)
#    ว่าง = ไม่มีข้อยกเว้นให้เจ้าของบัญชีเมื่อถูกยิงรหัสผิดจากหลาย IP (ปลอดภัย แต่เจ้าของอาจโดนล็อก 15 นาที)
#    สุ่มต่อ environment: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ---------------------------------------------------------------- ฟีเจอร์ที่เปิด/ปิดได้
FEATURE_AUTH=true
FEATURE_MANUAL=true
FEATURE_SUPPORT=true
